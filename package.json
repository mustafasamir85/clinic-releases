{
  "name": "clinic-management",
  "private": true,
  "version": "1.3.12",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "prestart": "npm run build",
    "start": "electron .",
    "build": "vite build",
    "package:win": "npm run build && electron-builder --win nsis",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "jo.qaf.clinicmanagement",
    "productName": "Clinic Management",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "main.cjs",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/clinic-icon.ico",
      "artifactName": "Clinic-Management-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/clinic-icon.ico",
      "uninstallerIcon": "public/clinic-icon.ico"
    }
  }
}
